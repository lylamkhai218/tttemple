{
  // Local-only synthetic account. Never deploy this configuration.
  "name": "tttemple-webauthn-poc-local",
  "main": "worker-cloudflare.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SMOKE_MODE": "1",
    "RP_ID": "localhost",
    "RP_ORIGIN": "http://localhost:5178"
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNTHETIC_AUTH", "class_name": "SyntheticAuthAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyntheticAuthAccount"] }],
  "triggers": { "crons": [] }
}
